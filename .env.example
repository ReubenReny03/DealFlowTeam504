# ---- DealFlow360 environment ----
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# Mongo. Single-node replica set (see docker-compose.yml) so transactions work.
MONGO_URI=mongodb://127.0.0.1:27017/dealflow360?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=dealflow360

# Auth
JWT_SECRET=dealflow360-dev-secret-change-me
JWT_EXPIRES_IN=12h
PORTAL_TOKEN_TTL_DAYS=3650

# Frontend
WEB_ORIGIN=http://localhost:4200
WEB_BASE_URL=http://localhost:4200

# Demo behaviour
SHOW_DEMO_LOGINS=true
SEED_NOW=                # optional ISO date; blank = "now" at seed time
DEMO_PASSWORD=Demo@123
BCRYPT_ROUNDS=8          # low on purpose: seed of 7 users must stay under 30s
